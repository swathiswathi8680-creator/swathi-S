submit"&gt;Summarize&lt;/button&gt;[span_108](start_span)[span_108](end_span)<br> &nbsp; &nbsp;&lt;/form&gt;<br> &nbsp; &nbsp;&lt;div id="summaryResult" class="output"&gt;&lt;/div&gt;[span_109](start_span)[span_109](end_span)<br><br> &nbsp; &nbsp;&lt;!-- Quiz --&gt;[span_110](start_span)[span_110](end_span)<br> &nbsp; &nbsp;&lt;form id="quizForm"&gt;[span_111](start_span)[span_111](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;&lt;label&gt;&lt;strong&gt;Generate a Quiz:&lt;/strong&gt;&lt;/label&gt;&lt;br&gt;&lt;br&gt;[span_112](start_span)[span_112](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;&lt;input type="text" id="quizText" placeholder="Solar System" required&gt;[span_113](start_span)[span_113](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;&lt;button type="submit"&gt;Generate Quiz&lt;/button&gt;[span_114](start_span)[span_114](end_span)<br> &nbsp; &nbsp;&lt;/form&gt;<br> &nbsp; &nbsp;&lt;div id="quizResult" class="output"&gt;&lt;/div&gt;[span_115](start_span)[span_115](end_span)<br><br> &nbsp; &nbsp;&lt;!-- Learning Path --&gt;<br> &nbsp; &nbsp;&lt;form id="recommendForm"&gt;<br> &nbsp; &nbsp; &nbsp; &nbsp;&lt;label&gt;&lt;strong&gt;Get Learning Recommendations:&lt;/strong&gt;&lt;/label&gt;&lt;br&gt;&lt;br&gt;<br> &nbsp; &nbsp; &nbsp; &nbsp;&lt;input type="text" id="recommendTopic" placeholder="e.g. Linear Regression" required&gt;<br> &nbsp; &nbsp; &nbsp; &nbsp;&lt;button type="submit"&gt;Get Recommendations&lt;/button&gt;<br> &nbsp; &nbsp;&lt;/form&gt;<br> &nbsp; &nbsp;&lt;div id="recommendResult" class="output"&gt;&lt;/div&gt;<br><br> &nbsp; &nbsp;&lt;script&gt;<br> &nbsp; &nbsp; &nbsp; &nbsp;// Q&amp;A API Integration<br> &nbsp; &nbsp; &nbsp; &nbsp;document.getElementById('qaForm').addEventListener('submit', async (e) =&gt; {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;e.preventDefault();<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const question = document.getElementById('question').value;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const res = await fetch(`/qa?questi