bsp; &nbsp; &nbsp;});<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const data = await res.json();<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;document.getElementById('summaryResult').innerText = data.summary || data.error;<br> &nbsp; &nbsp; &nbsp; &nbsp;});<br><br> &nbsp; &nbsp; &nbsp; &nbsp;// Quiz API Integration<br> &nbsp; &nbsp; &nbsp; &nbsp;document.getElementById('quizForm').addEventListener('submit', async (e) =&gt; {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;e.preventDefault();<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const text = document.getElementById('quizText').value;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const res = await fetch('/quiz', {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;method: 'POST',<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;headers: { 'Content-Type': 'application/json' },<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;body: JSON.stringify({ text })<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;});<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const data = await res.json();<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const container = document.getElementById('quizResult');<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;container.innerHTML = '';<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;if (Array.isArray(data.quiz)) {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;data.quiz.forEach((q, idx) =&gt; {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;let html = `&lt;p&gt;&lt;strong&gt;Q${idx + 1}: ${q.question}&lt;/strong&gt;&lt;/p&gt;`;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;q.options.forEach(opt =&gt; {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;html += `&lt;label&gt;&lt;input type="radio" name="q${idx}" value="${opt}"&gt; ${opt}&lt;/label&gt;&lt;br&gt;`;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;});<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;html += `&lt;button onclick="checkAnswer(${idx}, '${q.answer}')"&gt;Check Answer&lt;/button&gt;`;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;html += `&lt;div id="quiz-ans-${idx}"&gt;&lt;/div&gt;&lt;hr&gt;`;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;container.innerHTML += html;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;});<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;} else {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;container.innerText = "Error generating quiz.";<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;}<br> &nbsp; &nbsp; &nbsp; &nbsp;});<br><br> &nbsp; &nbsp; &nbsp; &nbsp;function checkAnswer(idx, correctAns) {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const selected = document.querySelector(`input[name="q${idx}"]:checked`);<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const ansDiv = document.getElementById(`quiz-ans-${idx}`);<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;if (!selected) {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;ansDiv.innerHTML = "&lt;span style='color:orange;'&gt;Please select an option.&lt;/span&gt;";<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;return;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;}<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;if (selected.value === correctAns) {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;ansDiv.innerHTML = "&lt;span style='color:green;'&gt;‚úÖ Correct!&lt;/span&gt;";<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;} else {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;ansDiv.innerHTML = `&lt;span style='color:red;'&gt;‚ùå Incorrect. Correct answer: ${correctAns}&lt;/span&gt;`;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;}<br> &nbsp; &nbsp; &nbsp; &nbsp;}<br><br> &nbsp; &nbsp; &nbsp; &nbsp;// Recommendations API Integration<br> &nbsp; &nbsp; &nbsp; &nbsp;document.getElementById('recommendForm').addEventListener('submit', async (e) =&gt; {<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;e.preventDefault();<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const topic = document.getElementById('recommendTopic').value;<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const res = await fetch(`/learn/recommendations?topic=${encodeURIComponent(topic)}`);<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;const data = await res.json();<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;document.getElementById('recommendResult').innerText = data.recommendation || data.error;<br> &nbsp; &nbsp; &nbsp; &nbsp;});<br> &nbsp; &nbsp;&lt;/script&gt;<br>&lt;/body&gt;<br>&lt;/html&gt;<br></span></p><h3 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">9. static/style.css</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">body {<br> &nbsp; &nbsp;font-family: Arial, sans-serif;<br> &nbsp; &nbsp;background-color: #f4f6f9;<br> &nbsp; &nbsp;margin: 0;<br> &nbsp; &nbsp;padding: 20px;<br> &nbsp; &nbsp;text-align: center;<br>}<br><br>h1 {<br> &nbsp; &nbsp;color: #333;<br>}<br><br>form {<br> &nbsp; &nbsp;background: #ffffff;<br> &nbsp; &nbsp;margin: 20px auto;<br> &nbsp; &nbsp;padding: 20px;<br> &nbsp; &nbsp;border-radius: 8px;<br> &nbsp; &nbsp;max-width: 600px;<br> &nbsp; &nbsp;box-shadow: 0 2px 5px rgba(0,0,0,0.1);<br>}<br><br>input[type="text"] {<br> &nbsp; &nbsp;width: 80%;<br> &nbsp; &nbsp;padding: 10px;<br> &