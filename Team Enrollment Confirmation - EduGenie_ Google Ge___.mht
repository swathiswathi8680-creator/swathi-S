pan style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;project document-il ulla ella file-galin full source code keezhe kodukkappattu·∏∑·∏∑adhu.</span></p><h3 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">1. requirements.txt</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">fastapi<br>uvicorn<br>jinja2<br>google-generativeai<br>transformers<br>torch<br></span></p><h3 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">2. explanation_module.py</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">from transformers import AutoTokenizer, AutoModelForSeq2SeqLM<br>import torch<br><br># Load the improved model for explanations[span_1](start_span)[span_1](end_span)<br>explain_tokenizer = AutoTokenizer.from_pretrained("MBZUAI/LaMini-Flan-T5-783M")[span_2](start_span)[span_2](end_span)<br>explain_model = AutoModelForSeq2SeqLM.from_pretrained("MBZUAI/LaMini-Flan-T5-783M")[span_3](start_span)[span_3](end_span)<br><br>def explain_topic(topic: str) -&gt; str:<br> &nbsp; &nbsp;input_text = f"Explain the concept of '{topic}' in a simple and clear way for a school student.[span_4](start_span)"[span_4](end_span)<br> &nbsp; &nbsp;inputs = explain_tokenizer(input_text, return_tensors="pt")[span_5](start_span)[span_5](end_span)<br><br> &nbsp; &nbsp;outputs = explain_model.generate(<br> &nbsp; &nbsp; &nbsp; &nbsp;**inputs,<br> &nbsp; &nbsp; &nbsp; &nbsp;max_new_tokens=150,[span_6](start_span)[span_6](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;temperature=0.7,[span_7](start_span)[span_7](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;top_k=50,[span_8](start_span)[span_8](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;top_p=0.95,[span_9](start_span)[span_9](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;do_sample=True[span_10](start_span)[span_10](end_span)<br> &nbsp; &nbsp;)<br><br> &nbsp; &nbsp;explanation = explain_tokenizer.decode(outputs[0], skip_special_tokens=True)[span_11](start_span)[span_11](end_span)<br> &nbsp; &nbsp;return explanation[span_12](start_span)[span_12](end_span)<br></span></p><h3 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">3. qna.py</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">import google.generativeai as genai<br><br>def answer_question_with_gemini(question: str) -&gt; str:<br> &nbsp; &nbsp;try:<br> &nbsp; &nbsp; &nbsp; &nbsp;model = genai.GenerativeModel(model_name="models/gemini-1.5-pro")[span_13](start_span)[span_13](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;response = model.generate_content(question)[span_14](start_span)[span_14](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;return response.text.strip()[span_15](start_span)[span_15](end_span)<br> &nbsp; &nbsp;except Exception as e:<br> &nbsp; &nbsp; &nbsp; &nbsp;return f"‚ö†Ô∏è Error in QnA: {e}[span_16](start_span)"[span_16](end_span)<br></span></p><h3 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">4. quiz_module.py</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">import re<br>import json<br>import google.generativeai as genai<br><br>def clean_json_block(text: str) -&gt; str:<br> &nbsp; &nbsp;# Remove Markdown ```json code fences[span_17](start_span)[span_17](end_span)<br> &nbsp; &nbsp;return re.sub(r"```(?:json)?\n(.*?)```", r"\1", text, flags=re.DOTALL).strip()[span_18](start_span)[span_18](end_span)<br><br>def generate_quiz(text: str) -&gt; list:<br> &nbsp; &nbsp;try:<br> &nbsp; &nbsp; &nbsp; &nbsp;model = genai.GenerativeModel(model_name="models/gemini-1.5-pro")[span_19](start_span)[span_19](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;<br> &nbsp; &nbsp; &nbsp; &nbsp;prompt = f"""<br>You are a quiz generator.[span_20](start_span)[span_20](end_span)<br><br>From the following passage, create 3 multiple-choice questions. Each question should include:[span_21](start_span)[span_21](end_span)<br>- A "question[span_22](start_span)"[span_22](end_span)<br>- A list of 4 "options[span_23](start_span)"[span_23](end_span)<br>- A correct "answer" that must exactly match one of the options.[span_24](start_span)[span_24](end_span)<br><br>Format your output as **valid JSON**, like this:[span_25](start_span)[span_25](end_span)<br>[<br> &nbsp;{{<br> &nbsp; &nbsp;"question": "What is ...?",[span_26](start_span)[span_26](end_span)<br> &nbsp; &nbsp;"options": ["A", "B", "C", "D"],[span_27](start_span)[span_27](end_span)<br> &nbsp; &nbsp;"answer": "A[span_28](start_span)"[span_28](end_span)<br> &nbsp;}}<br>]<br><br>Passage:<br>{text}[span_29](start_span)[span_29](end_span)<br>"""<br> &nbsp; &nbsp; &nbsp; &nbsp;response = model.generate_content(prompt)[span_30](start_span)[span_30](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;quiz_text = response.text.strip()[span_31](start_span)[span_31](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;<br> &nbsp; &nbsp; &nbsp; &nbsp;# Clean markdown code blocks if any[span_32](start_span)[span_32](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;cleaned_text = clean_json_block(quiz_text)[span_33](start_span)[span_33](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;return json.loads(cleaned_text)<br> &nbsp; &nbsp;except Exception as e:<br> &nbsp; &nbsp; &nbsp; &nbsp;return [{"error": f"Error generating quiz: {e}"}]<br></span></p><h3 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">5. summary_module.py</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">import google.generativeai as genai<br><br>def summarize_text(text: str) -&gt; str:<br> &nbsp; &nbsp;try:<br> &nbsp; &nbsp; &nbsp; &nbsp;model = genai.GenerativeModel(model_name="models/gemini-1.5-pro")[span_34](start_span)[span_34](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;prompt = f"Summarize the following text in simple language:\n\n{text}[span_35](start_span)"[span_35](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;response = model.generate_content(prompt)[span_36](start_span)[span_36](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;return response.text.strip()[span_37](start_span)[span_37](end_span)<br> &nbsp; &nbsp;except Exception as e:<br> &nbsp; &nbsp; &nbsp; &nbsp;return f"‚ö†Ô∏è Error in Summary: {e}[span_38](start_span)"[span_38](end_span)<br></span></p><h3 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">6. learning_path.py</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">import traceback<br>import google.generativeai as genai<br><br>def get_learning_recommendations(topic: str):<br> &nbsp; &nbsp;prompt = f"""<br>You are an AI tutor. The student wants to learn about: {topic}.[span_39](start_span)[span_39](end_span)<br>Suggest a structured and adaptive learning path including key topics, order of learning, and resources.[span_40](start_span)[span_40](end_span)<br>Include beginner, intermediate, and advanced levels if needed.[span_41](start_span)[span_41](end_span)<br>"""<br> &nbsp; &nbsp;try:<br> &nbsp; &nbsp; &nbsp; &nbsp;model = genai.GenerativeModel(model_name="models/gemini-1.5-pro")<br> &nbsp; &nbsp; &nbsp; &nbsp;response = model.generate_content(prompt)[span_42](start_span)[span_42](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;print("üß† Gemini raw response:", response)[span_43](start_span)[span_43](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;<br> &nbsp; &nbsp; &nbsp; &nbsp;if hasattr(response, "text"):[span_44](start_span)[span_44](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;return response.text[span_45](start_span)[span_45](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;elif hasattr(response, "parts") and response.parts:[span_46](start_span)[span_46](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;return response.parts[0].text[span_47](start_span)[span_47](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;else:<br> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;return "‚ùå Could not extract content from Gemini response.[span_48](start_span)"[span_48](end_span)<br> &nbsp; &nbsp;except Exception as e:<br> &nbsp; &nbsp; &nbsp; &nbsp;traceback.print_exc() &nbsp;# This gives full error trace[span_49](start_span)[span_49](end_span)<br> &nbsp; &nbsp; &nbsp; &nbsp;return f"‚ùå Error occurred: {str(e)}[span_50](start_span)"[span_50](end_span)<br></span></p><h3 style="padding-top:0pt;margin:0;color:#000000;font-weight:700;padding-left:0;font-size:14pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:&quot;Arial&quot;;font-style:normal">7. main.py</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.0;text-align:left;padding-right:0"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Courier&quot;;font-style:normal">import os<br>import google.generativeai as genai<br>from fastapi import FastAPI, Request, Query<br>from fastapi.responses import HTMLResponse, JSONResponse<br>from fastapi.staticfiles import StaticFiles<br>from fastapi.templating import Jinja2Templates<br><br># Local Module Imports<br>from qna import answer_question_with_gemini<br>from explanation_module import explain_topic<br>from summary_module import summarize_text<br>from quiz_module import generate_quiz<br>from learning_path import get_learning_recommendations<br><br># Configure Gemini API Key<br>GENAI_API_KEY = os.getenv("GEMINI_API_KEY", "YOUR_GEMINI_API_KEY")<br>genai.configure(api_key=GENAI_API_KEY)<br><br>app = FastAPI(title="EduGenie")<br><br>app.mount("/static", StaticFiles(directory="static"), name="static")<br>templates = Jinja2Templates(directory="templates")<br><br>@app.get("/", response_class=HTMLResponse)<br>async def read_root(request: Request):<br> &nbsp; &nbsp;return templates.TemplateResponse("index.html", {"request": request})<br><br># Q&amp;A - GET API using Gemini[span_51](start_span)[span_51](end_span)<br>@app.get("/qa")[span_52](start_span)[span_52](end_span)<br>async def answer_question(question: str = Query(...)):[span_53](start_span)[span_53](end_span)<br> &nbsp; &nbsp;answer = answer_question_with_gemini(question)[span_54](start_span)[span_54](end_span)<br> &nbsp; &nbsp;return {"answer": answer}[span_55](start_span)[span_55](end_span)<br><br># Explanation - POST API[span_56](start_span)[span_56](end_span)<br>@app.post("/explain/")[span_57](start_span)[span_57](end_span)<br>async def explain_api(request: Request):[span_58](start_span)[span_58](end_span)<br> &nbsp; &nbsp;data = await request.json()[span_59](start_span)[span_59](end_span)<br> &nbsp; &nbsp;topic = data.get("topic")[span_60](start_span)